#!/bin/sh

uci set system.@system[0].hostname='QWAIRAH-CF-WA350'
uci set system.@system[0].zonename='Asia/Aden'
uci set system.@system[0].timezone='AST-3'
uci commit system

mkdir -p /tmp/sysinfo
echo "COMFAST CF-WA350" > /tmp/sysinfo/model 2>/dev/null || true
if [ -f /tmp/sysinfo/board.json ]; then
    sed -i 's/"name": *"[^"]*"/"name": "COMFAST CF-WA350"/g' /tmp/sysinfo/board.json 2>/dev/null || true
fi

uci set luci.main.lang='ar'
uci commit luci

for hdr in /www/luci-static/bootstrap/header.htm /usr/lib/lua/luci/view/themes/bootstrap/header.htm /usr/share/ucode/luci/template/themes/bootstrap/header.ut; do
    if [ -f "$hdr" ] && ! grep -q "qwairah_custom.css" "$hdr"; then
        sed -i 's|</head>|<link rel="stylesheet" href="/luci-static/bootstrap/css/qwairah_custom.css" /></head>|g' "$hdr"
    fi
done

for ftr in /www/luci-static/bootstrap/footer.htm /usr/lib/lua/luci/view/themes/bootstrap/footer.htm /usr/share/ucode/luci/template/themes/bootstrap/footer.ut; do
    if [ -f "$ftr" ] && ! grep -q "qwairah_menu_toggle.js" "$ftr"; then
        sed -i 's|</body>|<script src="/luci-static/resources/qwairah_menu_toggle.js"></script></body>|g' "$ftr"
    fi
done

uci set network.lan.ipaddr='192.168.1.1'
uci set network.lan.netmask='255.255.255.0'
uci delete network.lan.dns 2>/dev/null
uci add_list network.lan.dns='1.1.1.3'
uci add_list network.lan.dns='1.0.0.3'
uci delete network.lan.ip6assign 2>/dev/null

if uci -q get network.wan >/dev/null; then
    WAN_DEV=$(uci -q get network.wan.device || uci -q get network.wan.ifname)
    if [ -n "$WAN_DEV" ]; then
        uci add_list network.@device[0].ports="$WAN_DEV" 2>/dev/null
    fi
    uci delete network.wan 2>/dev/null
    uci delete network.wan6 2>/dev/null
fi
uci commit network

uci set dhcp.lan.ignore='1'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ra='disabled'
uci commit dhcp

# CF-WA350: معكوس حسب الطلب — radio0 = 5.8GHz أولاً، radio1 = 2.4GHz ثانياً
uci set wireless.radio0.disabled='0'
uci set wireless.radio0.channel='104'
uci set wireless.radio0.htmode='HT40'
uci set wireless.radio0.txpower='23'
uci set wireless.radio0.country='PA'
uci delete wireless.radio0.macaddr 2>/dev/null

uci set wireless.default_radio0='wifi-iface'
uci set wireless.default_radio0.device='radio0'
uci set wireless.default_radio0.network='lan'
uci set wireless.default_radio0.mode='ap'
uci set wireless.default_radio0.wds='1'
uci set wireless.default_radio0.ssid='QWAIRAH 5.8G'
uci set wireless.default_radio0.encryption='none'
uci delete wireless.default_radio0.macaddr 2>/dev/null

uci set wireless.radio1.disabled='0'
uci set wireless.radio1.channel='6'
uci set wireless.radio1.htmode='HT20'
uci set wireless.radio1.txpower='20'
uci set wireless.radio1.country='PA'
uci delete wireless.radio1.macaddr 2>/dev/null

uci set wireless.default_radio1='wifi-iface'
uci set wireless.default_radio1.device='radio1'
uci set wireless.default_radio1.network='lan'
uci set wireless.default_radio1.mode='ap'
uci set wireless.default_radio1.wds='1'
uci set wireless.default_radio1.ssid='QWAIRAH 2.4G'
uci set wireless.default_radio1.encryption='none'
uci delete wireless.default_radio1.macaddr 2>/dev/null
uci commit wireless

touch /etc/crontabs/root
[ -f /etc/qwairah_tg.conf ] || cat << 'CONFEOF' > /etc/qwairah_tg.conf
BOT_TOKEN=""
CHAT_ID=""
NODE_NAME="QWAIRAH-CF-WA350"
CONFEOF

for led in /sys/class/leds/*; do
    [ -d "$led" ] && echo "default-on" > "$led/trigger" 2>/dev/null
done

/etc/init.d/firewall disable 2>/dev/null
/etc/init.d/firewall stop 2>/dev/null
/etc/init.d/cron enable 2>/dev/null
/etc/init.d/lldpd enable 2>/dev/null
/etc/init.d/lldpd start 2>/dev/null
/etc/init.d/watchcat enable 2>/dev/null
/etc/init.d/qwairah-tg enable 2>/dev/null

if ! grep -q "qwairah_mndp" /etc/rc.local; then
    sed -i 's|exit 0|echo "COMFAST CF-WA350" > /tmp/sysinfo/model 2>/dev/null\nsed -i '\''s/"name": *"[^"]*"/"name": "COMFAST CF-WA350"/g'\'' /tmp/sysinfo/board.json 2>/dev/null\n/usr/bin/qwairah_mndp \&\nexit 0|g' /etc/rc.local
fi

rm -rf /tmp/luci-indexcache /tmp/luci-modulecache /var/luci-* 2>/dev/null || true
exit 0

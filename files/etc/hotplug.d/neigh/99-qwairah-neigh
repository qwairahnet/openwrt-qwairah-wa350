#!/bin/sh
if [ "$ACTION" = "add" ] || [ "$ACTION" = "new" ]; then
    MAC_ADDR="${LLADDR:-unknown}"
    [ "$MAC_ADDR" = "unknown" ] && exit 0
    IP_FOUND=$(awk -v m="$MAC_ADDR" 'tolower($4)==tolower(m){print $1; exit}' /proc/net/arp 2>/dev/null)
    HOST_FOUND=$(awk -v m="$MAC_ADDR" 'tolower($3)==tolower(m){print $4; exit}' /tmp/dhcp.leases 2>/dev/null)
    /usr/bin/qwairah-tg-notify.sh event "ارتباط جهاز/مودم جديد | الواجهة: ${DEV:-br-lan} | MAC: ${MAC_ADDR} | IP: ${IP_FOUND:-غير محدد} | الاسم: ${HOST_FOUND:-غير معروف}" >/dev/null 2>&1 &
fi
